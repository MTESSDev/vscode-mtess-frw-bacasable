{
	"compilerOptions": {
		"module": "es2020",
		"target": "es2020",
		"outDir": "out",
		"lib": [
			"es2020",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"moduleResolution": "node",
		"esModuleInterop": true
	},
	"exclude": [
		"node_modules",
		".vscode-test",
		"src/test"
	]
}
