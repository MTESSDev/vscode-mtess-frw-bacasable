{
  "name": "vscode-mtess-frw-bacasable",
  "displayName": "MTESS - Formulaires bac à sable",
  "publisher": "mtess",
  "repository": "https://github.com/MTESSDev/vscode-mtess-frw-bacasable",
  "description": "Configurez vos formulaires avec l'outil du MTESS en temps réel!",
  "icon": "docs/icon-128.png",
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onCommand:vscode-mtess-frw-bacasable.open",
    "onLanguageModelTool:mtess-frw-bacasable_preview"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-mtess-frw-bacasable.open",
        "title": "FRW - Ouvrir bac à sable formulaire"
      },
      {
        "command": "vscode-mtess-frw-bacasable.init",
        "title": "FRW - Initialiser le workspace pour Claude Code"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-mtess-frw-bacasable.open",
        "when": "resourceFilename =~ /\\.form\\.yml/",
        "key": "ctrl+s",
        "mac": "cmd+s"
      }
    ],
    "languageModelTools": [
      {
        "name": "mtess-frw-bacasable_preview",
        "displayName": "Prévisualiser le formulaire FRW",
        "modelDescription": "OBLIGATOIRE — appelle cet outil immédiatement après chaque création ou modification d'un fichier .form.yml, sans exception. Ne termine jamais une tâche FRW sans avoir appelé cet outil. Ouvre ou rafraîchit le panneau bac à sable FRW pour afficher le rendu du formulaire modifié. Si le résultat contient des ERREURS, corrige le YAML en conséquence puis rappelle cet outil jusqu'à ce que le rendu soit sans erreur.",
        "icon": "$(preview)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Chemin optionnel vers un fichier .form.yml à prévisualiser. Si absent, utilise l'éditeur actif."
            },
            "line": {
              "type": "number",
              "description": "Numéro de ligne (1-based) à cibler pour le breadcrumb de prévisualisation. Utile pour montrer un élément précis du formulaire."
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "MTESS Formulaires",
      "properties": {
        "mtessFrwBacasable.url": {
          "type": "string",
          "default": null,
          "description": "URL à utiliser pour produire le rendu."
        },
        "mtessFrwBacasable.pane": {
          "type": "string",
          "default": "Beside",
          "enum": [
            "Active",
            "Beside",
            "One",
            "Two",
            "Three",
            "Four",
            "Five",
            "Six",
            "Seven",
            "Eight",
            "Nine"
          ],
          "enumDescriptions": [
            "Open in the active pane",
            "Open in the pane beside the active one",
            "Open in the first pane",
            "Open in the second pane",
            "Open in the third pane",
            "Open in the fourth pane",
            "Open in the fifth pane",
            "Open in the sixth pane",
            "Open in the seventh pane",
            "Open in the eighth pane",
            "Open in the ninth pane"
          ]
        },
        "mtessFrwBacasable.deployClaudeCodeSkill": {
          "type": "boolean",
          "default": true,
          "description": "Déploie automatiquement le skill Claude Code dans .claude/skills/ du workspace à l'ouverture. Désactiver si vous ne souhaitez pas que l'extension modifie votre configuration Claude Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "compile:tsc": "tsc -p ./",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "pretest": "yarn run compile:tsc && yarn run lint",
    "test": "node ./out/test/runTest.js",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=."
  },
  "devDependencies": {
    "@types/glob": "^7.1.1",
    "@types/mocha": "^7.0.2",
    "@types/node": "^13.11.0",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^2.30.0",
    "@typescript-eslint/parser": "^2.30.0",
    "@vscode/test-web": "^0.0.80",
    "eslint": "^6.8.0",
    "glob": "^7.1.6",
    "mocha": "^7.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "vscode-test": "^1.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ]
}
